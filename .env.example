# clueless environment settings. Copy this file to .env and fill it in.
# The app reads ./.env first, then ~/.config/clueless/.env (or pass
# --env-file). Process environment variables win over this file.

# --- LLM (chat server with an OpenAI-compatible /v1/chat/completions) ---

# Required. Base URL of the server; the app appends /v1/... itself.
# Examples: http://localhost:8000 (vLLM), https://api.openai.com
LLM_BASE_URL=http://localhost:8000

# Required. Model id sent with every chat request.
LLM_MODEL=your-model-id

# Optional. Sent as "Authorization: Bearer <key>" on every LLM request.
# LLM_API_KEY=sk-...

# Optional. Max tokens for a suggestion answer (default 220).
# LLM_MAX_TOKENS=220

# Optional. Sampling temperature (default 0.4).
# LLM_TEMPERATURE=0.4

# Optional. Text file with your own notes (name, role, background), placed in
# the system message of every request; ~ is expanded.
# LLM_NOTES_PATH=~/.config/clueless/notes.txt

# Optional. true or false. Unset omits the chat_template_kwargs field
# entirely; false sends enable_thinking=false (vLLM/Qwen models).
# LLM_ENABLE_THINKING=false

# --- ASR (transcription server with an OpenAI-compatible
#     /v1/audio/transcriptions) ---

# Required. Base URL of the server; the app appends /v1/... itself.
# Example: http://localhost:8097
ASR_BASE_URL=http://localhost:8097

# Required. Model id sent with every transcription request.
# Example: some-org/some-sensevoice-style-model-onnx
ASR_MODEL=your-asr-model-id

# Optional. Sent as "Authorization: Bearer <key>" on every ASR request.
# ASR_API_KEY=...

# Optional. Language code sent with every transcription request
# (example: en). Unset lets the server detect the language.
# ASR_LANGUAGE=en
